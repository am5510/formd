# ตั้งค่าผ่าน wrangler.jsonc (Binding: env.DB)
# Database ID: 0e4e03a8-9cb7-4f96-9db5-86702ec91206

# ==============================================================================
# การตั้งค่าระบบจัดเก็บไฟล์ CLOUDFLARE R2 (S3-Compatible Object Storage)
# ==============================================================================
# นำมาจาก Cloudflare Dashboard: https://dash.cloudflare.com > R2 > Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="training-form-r2"
# Public URL ของ R2 Bucket (เมื่อเปิด Public Access หรือใช้ Custom Domain / r2.dev)
CLOUDFLARE_R2_PUBLIC_URL="https://pub-your-bucket-id.r2.dev"

# ==============================================================================
# การตั้งค่าระบบทั่วไป
# ==============================================================================
NEXT_PUBLIC_APP_NAME="ระบบประเมินโครงการฝึกอบรม | Training Evaluation System"
NEXT_PUBLIC_DEFAULT_PROJECT_ID="PRJ-2567-TR048"
